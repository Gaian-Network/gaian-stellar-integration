{
  "name": "stellar-integration",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -b packages/config packages/core packages/db packages/chains && tsc -p tsconfig.json",
    "type-check": "tsc -b packages/config packages/core packages/db packages/chains --noEmit && tsc -p tsconfig.json --noEmit",
    "dev": "sh -c 'if [ -f .env ]; then tsx watch --env-file=.env src/app.ts; else tsx watch src/app.ts; fi'",
    "clean": "rm -rf dist packages/*/dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/sensible": "^6.0.1",
    "@gaian-stellar-integration/chains": "workspace:*",
    "@gaian-stellar-integration/config": "workspace:*",
    "@gaian-stellar-integration/core": "workspace:*",
    "@gaian-stellar-integration/db": "workspace:*",
    "axios": "^1.7.9",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.7.0",
    "pg": "^8.13.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
